# Google AI (current SDK and model names)
GEMINI_API_KEY=your_gemini_api_key
GEMINI_GENERATION_MODEL=gemini-3.6-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-2

# Supabase backend secret. Never expose this value in the frontend.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_server_side_secret_key
SUPABASE_STORAGE_BUCKET=documents
SIGNED_URL_TTL_SECONDS=900

# App
APP_ENV=development
# Keep false for deployed/private data. True is only for an explicit metadata-only local demo.
ALLOW_LOCAL_FALLBACK=false
ALLOWED_ORIGINS=http://localhost:5173
MAX_UPLOAD_MB=15
CHROMA_PATH=./chroma_data
CHROMA_COLLECTION=memoryverse_evidence_chunks_v4
CHUNK_SIZE_CHARS=2600
CHUNK_OVERLAP_CHARS=350
RAG_TOP_K=8
RAG_CANDIDATE_K=16
RERANK_TOP_K=8
RERANK_ENABLED=true
GRAPH_EXPANSION_LIMIT=4
REVIEW_CONFIDENCE_THRESHOLD=0.70

# Optional: increases GitHub API limits for repository ingestion.
GITHUB_TOKEN=
TESSERACT_CMD=
