digraph MemoryVersePitch {
  graph [rankdir=LR, bgcolor="#07101f", pad="0.45", nodesep="0.55", ranksep="0.7", fontname="Arial", splines=ortho];
  node [shape=box, style="rounded,filled", fontname="Arial", fontsize=12, color="#334155", fontcolor="#e2e8f0", fillcolor="#111c30", margin="0.22,0.16"];
  edge [fontname="Arial", fontsize=9, color="#64748b", fontcolor="#94a3b8", arrowsize=0.8];

  ingest [label="1 · INGEST EVIDENCE\nFiles · OCR · GitHub\nPreserve original source", fillcolor="#172554", color="#60a5fa"];
  gate [label="2 · REVIEW GATE\nExtract metadata + confidence\nHold low-confidence records out", fillcolor="#3b2b10", color="#f59e0b"];
  knowledge [label="3 · BUILD PROOF LAYER\nPage chunks + embeddings\nEvidence graph + re-ranking", fillcolor="#12312f", color="#34d399"];
  answer [label="4 · DELIVER TRUSTED IDENTITY\nCited answer + scores\nCareer passport + gap map", fillcolor="#3b1d52", color="#c084fc"];

  ingest -> gate [label="understand"];
  gate -> knowledge [label="only reviewed evidence"];
  knowledge -> answer [label="retrieve + explain"];
}
