# Leave blank in local development to use the Vite /api proxy.
# For deployment, set the public backend origin, for example https://api.example.com
VITE_API_URL=

# Supabase browser-safe project credentials (never use the server secret here).
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_publishable_or_anon_key
